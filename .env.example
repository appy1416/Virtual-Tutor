# FastAPI Server Configuration
PORT=8000
HOST=0.0.0.0

# Database Configuration
# Set MONGODB_URL to mongodb://localhost:27017 if running MongoDB locally
# Set to mongodb://admin:adminpassword@localhost:27017 if running through the provided docker-compose
MONGODB_URL=mongodb://admin:adminpassword@localhost:27017
MONGODB_DB_NAME=ai_tutor_db

# Security & JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Providers Configuration
# Supported values: gemini | openai
LLM_PROVIDER=gemini

# Gemini API Key (Required if LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Required if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here

# Google OAuth Configuration (Client ID on frontend & backend, Client Secret on backend only)
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

